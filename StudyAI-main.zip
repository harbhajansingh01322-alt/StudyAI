import 'dart:convert';
import 'package:http/http.dart' as http;
import '../constants/app_constants.dart';

/// AI Service - Handles all AI interactions.
/// Currently uses OpenAI-compatible API. Replace with Gemini, Claude, or local model as needed.
class AiService {
  final String apiKey;
  final String baseUrl;
  final String model;

  AiService({
    this.apiKey = AppConstants.openAiApiKey,
    this.baseUrl = AppConstants.openAiBaseUrl,
    this.model = AppConstants.defaultModel,
  });

  /// Generic chat completion
  Future<String> chat({
    required List<Map<String, String>> messages,
    String? systemPrompt,
    double temperature = 0.7,
    int maxTokens = 1500,
  }) async {
    // Fallback mock response when no real API key is set
    if (apiKey == 'YOUR_OPENAI_API_KEY' || apiKey.isEmpty) {
      return _mockResponse(messages.last['content'] ?? '');
    }

    final List<Map<String, String>> fullMessages = [];
    if (systemPrompt != null) {
      fullMessages.add({'role': 'system', 'content': systemPrompt});
    }
    fullMessages.addAll(messages);

    try {
      final response = await http.post(
        Uri.parse('$baseUrl/chat/completions'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $apiKey',
        },
        body: jsonEncode({
          'model': model,
          'messages': fullMessages,
          'temperature': temperature,
          'max_tokens': maxTokens,
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        return data['choices'][0]['message']['content'] as String;
      } else {
        throw Exception(
          'AI API error: ${response.statusCode} - ${response.body}',
        );
      }
    } catch (e) {
      // Graceful fallback
      return _mockResponse(
        messages.last['content'] ?? '',
        error: e.toString(),
      );
    }
  }

  /// Homework solver with step-by-step explanation
  Future<String> solveHomework({
    required String question,
    required String subject,
    String language = 'English',
    String examBoard = 'CBSE',
  }) async {
    final system = '''
You are an expert $subject tutor for $examBoard students in India.
Language: $language.
Provide clear, step-by-step solutions. Use simple language.
Format with markdown: use **bold**, numbered steps, and final answer clearly marked.
If the question is mathematical, show formulas properly.
''';

    return chat(
      messages: [
        {
          'role': 'user',
          'content': question,
        }
      ],
      systemPrompt: system,
      temperature: 0.3,
    );
  }

  /// Generate notes
  Future<String> generateNotes({
    required String topic,
    required String style,
    String subject = 'General',
    String language = 'English',
  }) async {
    String styleInstruction;

    switch (style) {
      case 'short':
        styleInstruction =
            'Create concise short notes (1 page max).';
        break;

      case 'detailed':
        styleInstruction =
            'Create detailed comprehensive notes.';
        break;

      case 'bullets':
        styleInstruction =
            'Create well-structured bullet-point notes.';
        break;

      case 'mindmap':
        styleInstruction =
            'Create a textual mind-map structure with hierarchical topics.';
        break;

      case 'flashcards':
        styleInstruction =
            'Create 8-12 flashcards in Q&A format suitable for revision.';
        break;

      default:
        styleInstruction = 'Create clear study notes.';
    }    final system = '''
You are an expert educational content creator for Indian students.
Subject: $subject. Language: $language.
$styleInstruction
Use markdown formatting. Make it exam-oriented and easy to remember.
''';

    return chat(
      messages: [
        {'role': 'user', 'content': 'Generate notes on: $topic'},
      ],
      systemPrompt: system,
    );
  }

  /// Generate quiz
  Future<String> generateQuiz({
    required String topic,
    required String type,
    int count = 5,
    String difficulty = 'medium',
    String language = 'English',
  }) async {
    String typeInstruction;

    switch (type) {
      case 'mcq':
        typeInstruction =
            'Generate $count Multiple Choice Questions with 4 options each and mark the correct answer.';
        break;
      case 'truefalse':
        typeInstruction =
            'Generate $count True/False questions with answers.';
        break;
      case 'fill':
        typeInstruction =
            'Generate $count Fill-in-the-blanks questions with answers.';
        break;
      case 'short':
        typeInstruction =
            'Generate $count Short Answer questions (2-3 marks) with model answers.';
        break;
      case 'long':
        typeInstruction =
            'Generate $count Long Answer questions (5-8 marks) with model answers.';
        break;
      default:
        typeInstruction = 'Generate $count mixed questions.';
    }

    final system = '''
You are an expert question paper setter for Indian board exams.
Language: $language. Difficulty: $difficulty.
$typeInstruction
Format clearly with question numbers and answers at the end or marked.
''';

    return chat(
      messages: [
        {'role': 'user', 'content': 'Topic: $topic'},
      ],
      systemPrompt: system,
      temperature: 0.5,
    );
  }

  /// Summarize PDF / text
  Future<String> summarizeText({
    required String text,
    String style = 'summary',
    String language = 'English',
  }) async {
    String instruction;

    switch (style) {
      case 'explain':
        instruction =
            'Explain the following content chapter-wise in simple language.';
        break;

      case 'important_questions':
        instruction =
            'Extract the most important questions that can be asked from this content along with short answers.';
        break;

      default:
        instruction =
            'Provide a clear, structured summary of the following content.';
    }

    final system =
        'You are a study assistant. Language: $language. $instruction Use markdown.';

    final truncated =
        text.length > 12000 ? text.substring(0, 12000) + '...' : text;

    return chat(
      messages: [
        {'role': 'user', 'content': truncated},
      ],
      systemPrompt: system,
      maxTokens: 2000,
    );
  }

  /// OCR Solver
  Future<String> answerFromImageText({
    required String ocrText,
    String language = 'English',
  }) async {
    final system = '''
You are an expert tutor.
OCR text may contain errors.
Correct the question and solve it step-by-step.
''';

    return chat(
      messages: [
        {'role': 'user', 'content': ocrText},
      ],
      systemPrompt: system,
      temperature: 0.3,
    );
  }

  String _mockResponse(String query, {String? error}) {
    if (error != null) {
      return '''
**Demo Mode**

Real AI is not configured yet.

Query:
$query

Configure your API key in:import 'package:flutter/material.dart';
