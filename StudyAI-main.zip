class HomeworkScreen extends StatefulWidget {
  const HomeworkScreen({super.key});

  @override
  State<HomeworkScreen> createState() => _HomeworkScreenState();
}

class _HomeworkScreenState extends State<HomeworkScreen> {
  final _questionController = TextEditingController();
  final _ai = AiService();
  String _subject = 'Mathematics';
  String _language = 'English';
  String _examBoard = 'CBSE';
  String? _answer;
  bool _loading = false;

  Future<void> _solve() async {
    if (_questionController.text.trim().isEmpty) return;

    setState(() {
      _loading = true;
      _answer = null;
    });

    try {
      final result = await _ai.solveHomework(
        question: _questionController.text.trim(),
        subject: _subject,
        language: _language,
        examBoard: _examBoard,
      );

      setState(() => _answer = result);
    } catch (e) {
      setState(() => _answer = 'Error: $e');
    } finally {
      setState(() => _loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Homework Solver'),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Row(
              children: [
                Expanded(
                  child: DropdownButtonFormField<String>(
                    value: _subject,
                    decoration: const InputDecoration(
                      labelText: 'Subject',
                    ),
                    items: AppConstants.subjects
                        .map(
                          (s) => DropdownMenuItem(
                            value: s,
                            child: Text(
                              s,
                              overflow: TextOverflow.ellipsis,
                            ),
                          ),
                        )
                        .toList(),
                    onChanged: (v) {
                      setState(() => _subject = v!);
                    },
                  ),
                ),

                const Gap(12),

                Expanded(
                  child: DropdownButtonFormField<String>(
                    value: _examBoard,
                    decoration: const InputDecoration(
                      labelText: 'Board / Exam',
                    ),
                    items: AppConstants.examModes
                        .map(
                          (s) => DropdownMenuItem(
                            value: s,
                            child: Text(s),
                          ),
                        )
                        .toList(),
                    onChanged: (v) {
                      setState(() => _examBoard = v!);
                    },
                  ),
                ),
              ],
            ),

            const Gap(12),

            DropdownButtonFormField<String>(
              value: _language,
              decoration: const InputDecoration(
                labelText: 'Language',
              ),
              items: AppConstants.supportedLanguages
                  .map(
                    (s) => DropdownMenuItem(
                      value: s,
                      child: Text(s),
                    ),
                  )
                  .toList(),
              onChanged: (v) {
                setState(() => _language = v!);
              },
            ),

            const Gap(16),

            TextField(
              controller: _questionController,
              maxLines: 5,
              decoration: const InputDecoration(
                labelText: 'Paste or type your question',
                hintText:
                    'e.g. Solve the quadratic equation x² - 5x + 6 = 0',
                alignLabelWithHint: true,
              ),
            ),

            const Gap(16),

            ElevatedButton.icon(
              onPressed: _loading ? null : _solve,
              icon: _loading
                  ? const SizedBox(
                      width: 18,
                      height: 18,
                      child: CircularProgressIndicator(
                        strokeWidth: 2,
                        color: Colors.white,
                      ),
                    )
                  : const Icon(Iconsax.teacher),
              label: Text(
                _loading
                    ? 'Solving...'
                    : 'Solve Step-by-Step',
              ),
            ),

            if (_answer != null) ...[
              const Gap(24),

              Row(
                mainAxisAlignment:
                    MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    'Solution',
                    style: Theme.of(context)
                        .textTheme
                        .titleMedium
                        ?.copyWith(
                          fontWeight: FontWeight.w600,
                        ),
                  ),
                  IconButton(
                    icon: const Icon(
                      Iconsax.copy,
                      size: 20,
                    ),
                    onPressed: () {
                      Clipboard.setData(
                        ClipboardData(text: _answer!),
                      );

                      ScaffoldMessenger.of(context)
                          .showSnackBar(
                        const SnackBar(
                          content: Text('Copied!'),
                        ),
                      );
                    },
                  ),
                ],
              ),

              const Gap(8),

              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(
                  color: Theme.of(context).brightness ==
                          Brightness.dark
                      ? AppTheme.darkCard
                      : Colors.grey.shade50,
                  borderRadius:
                      BorderRadius.circular(16),
                  border: Border.all(
                    color: AppTheme.primary
                        .withOpacity(0.2),
                  ),
                ),
                child: MarkdownBody(
                  data: _answer!,
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }

lib/core/constants/app_constants.dart
''';
    }

    return '''
**Demo Response**

